<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="@dimen/netease_mpay_oversea__codescanner_alert_width"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/netease_mpay_oversea_codescanner__alert_dialog_background"
    android:isScrollContainer="true"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <TextView
        android:id="@+id/netease_mpay_oversea__codescanner_alert_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingLeft="@dimen/netease_mpay_oversea__codescanner_padding_20"
        android:paddingRight="@dimen/netease_mpay_oversea__codescanner_padding_20"
        android:paddingTop="@dimen/netease_mpay_oversea__codescanner_padding_45"
        android:paddingBottom="@dimen/netease_mpay_oversea__codescanner_padding_45"
        android:textColor="@color/netease_mpay_oversea__codescanner_alert_font_color"
        android:textSize="@dimen/netease_mpay_oversea__codescanner_alert_font_size" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/netease_mpay_oversea__codescanner_alert_divider"
        android:background="@color/netease_mpay_oversea__codescanner_alert_divider"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/netease_mpay_oversea__codescanner_button_height_53"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/netease_mpay_oversea__codescanner_alert_btn_positive"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/netease_mpay_oversea__codescanner_button_height_53"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/netease_mpay_oversea__codescanner_alert_font_size"
            android:textColor="@color/netease_mpay_oversea__codescanner_alert_btn_font_color"/>

        <View
            android:id="@+id/netease_mpay_oversea__codescanner_alert_sep"
            android:layout_width="@dimen/netease_mpay_oversea__codescanner_alert_divider"
            android:layout_height="match_parent"
            android:background="@color/netease_mpay_oversea__codescanner_alert_divider" />
        <TextView
            android:id="@+id/netease_mpay_oversea__codescanner_alert_btn_negative"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/netease_mpay_oversea__codescanner_button_height_53"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/netease_mpay_oversea__codescanner_alert_font_size"
            android:textColor="@color/netease_mpay_oversea__codescanner_alert_btn_font_color"/>

    </LinearLayout>
</LinearLayout>