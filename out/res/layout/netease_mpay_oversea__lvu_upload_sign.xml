                    <TextView android:layout_gravity="center|right|top" android:id="@id/netease_mpay_oversea__lvu_image_delte" android:background="@drawable/netease_mpay_oversea__minor_img_delete" android:visibility="gone" android:layout_width="@dimen/netease_mpay_oversea__icon_15" android:layout_height="@dimen/netease_mpay_oversea__icon_15" />
                </FrameLayout>
                <FrameLayout android:layout_width="fill_parent" android:layout_height="0.0dip" android:layout_weight="1.0">
