<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:layout_width="fill_parent" android:layout_height="fill_parent">
        <FrameLayout android:layout_gravity="center" android:id="@id/netease_mpay_oversea__uc_content" android:background="@drawable/netease_mpay_oversea__popup_bg" android:layout_width="@dimen/netease_mpay_oversea__lvu_window_width" android:layout_height="@dimen/netease_mpay_oversea__lvu_window_height" android:layout_centerInParent="true">
            <LinearLayout android:orientation="vertical" android:padding="@dimen/netease_mpay_oversea__padding_15" android:layout_width="fill_parent" android:layout_height="fill_parent">
                <TextView android:textSize="@dimen/netease_mpay_oversea__text_14" android:textColor="@color/netease_mpay_oversea__popup_text" android:id="@id/netease_mpay_oversea__lvu_email_resent" android:paddingBottom="@dimen/netease_mpay_oversea__padding_5" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/netease_mpay_oversea__margin_15" android:text="@string/netease_mpay_oversea__lvu_email_resent_tips" />
                <TextView android:textSize="@dimen/netease_mpay_oversea__text_14" android:textColor="@color/netease_mpay_oversea__popup_text" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/netease_mpay_oversea__margin_5" android:layout_marginBottom="@dimen/netease_mpay_oversea__margin_15" android:text="@string/netease_mpay_oversea__lvu_upload_image_tips" />
                <FrameLayout android:layout_gravity="center_horizontal" android:layout_width="@dimen/netease_mpay_oversea__icon_95" android:layout_height="@dimen/netease_mpay_oversea__icon_95">
