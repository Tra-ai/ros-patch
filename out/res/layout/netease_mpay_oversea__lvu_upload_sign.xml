                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@id/netease_mpay_oversea__lvu_close" android:background="@drawable/netease_mpay_oversea__popup_close_background" android:layout_width="@dimen/netease_mpay_oversea__icon_35" android:layout_height="@dimen/netease_mpay_oversea__icon_35" android:layout_marginTop="@dimen/netease_mpay_oversea__margin_minus_10" android:layout_marginRight="@dimen/netease_mpay_oversea__margin_minus_10" android:layout_alignTop="@id/netease_mpay_oversea__uc_content" android:layout_alignRight="@id/netease_mpay_oversea__uc_content" />
