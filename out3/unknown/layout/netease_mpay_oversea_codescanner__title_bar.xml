<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/netease_mpay_oversea__codescanner_titlebar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical">

    <FrameLayout
        android:id="@+id/netease_mpay_oversea__codescanner_title_bar_back"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/netease_mpay_oversea_codescanner__title_bar_back" >

        <ImageView
            android:id="@+id/netease_mpay_oversea__codescanner_title_bar_back_ic"
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/netease_mpay_oversea__codescanner_title_bar_back_size"
            android:layout_height="@dimen/netease_mpay_oversea__codescanner_title_bar_back_size"
            android:layout_marginLeft="@dimen/netease_mpay_oversea__codescanner_title_bar_back_margin"
            android:layout_marginRight="@dimen/netease_mpay_oversea__codescanner_title_bar_back_margin"
            android:src="@drawable/netease_mpay_oversea_codescanner__ic_back_black" />
    </FrameLayout>

    <TextView
        android:id="@+id/netease_mpay_oversea__codescanner_title_bar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textSize="@dimen/netease_mpay_oversea__codescanner_title_bar_font_size" />

</FrameLayout>
