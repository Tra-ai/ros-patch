<?xml version="1.0" encoding="UTF-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/netease_mpay__login_codescanner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <SurfaceView
        android:id="@+id/netease_mpay__scanner_codescanner_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="top"
            android:layout_weight="1"
            android:background="@color/netease_mpay_oversea__codescanner_background_color_black_transparent" >
            <com.netease.mpay.oversea.scan.widgets.TitleBarView
                android:id="@+id/netease_mpay_oversea__codescanner_titlebar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/netease_mpay_oversea__codescanner_title_bar_height" />
    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/netease_mpay_oversea__codescanner_viewfinder_container_height"
            android:orientation="horizontal" >

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/netease_mpay_oversea__codescanner_background_color_black_transparent" />

            <RelativeLayout
                android:layout_width="@dimen/netease_mpay_oversea__codescanner_viewfinder_height"
                android:layout_height="match_parent"
                android:background="@drawable/netease_mpay_oversea_codescanner__scanner_rectangle_icon">

                <View
                    android:id="@+id/left"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:background="@color/netease_mpay_oversea__codescanner_background_color_black_transparent"
                    android:layout_alignParentLeft="true" />
                <View
                    android:id="@+id/right"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:background="@color/netease_mpay_oversea__codescanner_background_color_black_transparent"
                    android:layout_alignParentRight="true" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_toRightOf="@id/left"
                    android:layout_toLeftOf="@id/right"
                    android:background="@color/netease_mpay_oversea__codescanner_background_color_black_transparent"
                    android:layout_alignParentTop="true" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_toRightOf="@id/left"
                    android:layout_toLeftOf="@id/right"
                    android:background="@color/netease_mpay_oversea__codescanner_background_color_black_transparent"
                    android:layout_alignParentBottom="true" />

                <com.netease.mpay.oversea.scan.widgets.QRFinderView
                    android:id="@+id/netease_mpay__scanner_codescanner_frame"
                    android:layout_width="@dimen/netease_mpay_oversea__codescanner_viewfinder_height"
                    android:layout_height="@dimen/netease_mpay_oversea__codescanner_viewfinder_height"
                    android:layout_centerInParent="true"/>

            </RelativeLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/netease_mpay_oversea__codescanner_background_color_black_transparent" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@color/netease_mpay_oversea__codescanner_background_color_black_transparent" >
            <TextView
                android:id="@+id/netease_mpay__login_codescan_status_msg"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/netease_mpay_oversea__codescanner_font_color_white"
                android:text="@string/netease_mpay_oversea__codescanner_status_msg"
                android:visibility="visible"
                />
        </LinearLayout>
    </LinearLayout>

    <com.netease.mpay.oversea.scan.widgets.ProgressView
        android:id="@+id/progress"
        android:layout_gravity="center"
        android:layout_width="@dimen/netease_mpay_oversea__codescanner_padding_45"
        android:layout_height="@dimen/netease_mpay_oversea__codescanner_padding_45"
        android:visibility="gone"/>
</FrameLayout>
